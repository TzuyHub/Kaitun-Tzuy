local UIElements = {} -- table to hold elements that need theme updates

-- Apply Theme Function
local function ApplyTheme(themeName)
    local theme = Themes[themeName]
    if not theme then return end
    CurrentTheme = themeName
    
    -- Update all registered UI elements
    for _, element in ipairs(UIElements) do
        if element.Type == "Frame" then
            element.Instance.BackgroundColor3 = theme.MainBG
        elseif element.Type == "SecondaryFrame" then
            element.Instance.BackgroundColor3 = theme.SecondaryBG
        elseif element.Type == "TextLabel" then
            element.Instance.TextColor3 = theme.Text
        elseif element.Type == "TextButton" then
            element.Instance.BackgroundColor3 = theme.Button
            element.Instance.TextColor3 = theme.Text
        elseif element.Type == "ScrollingFrame" then
            element.Instance.BackgroundColor3 = theme.SecondaryBG
        end
    end
end

-- Helper to register element for theming
local function RegisterElement(element, elementType)
    table.insert(UIElements, {Instance = element, Type = elementType})
end

