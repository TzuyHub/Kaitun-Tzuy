-- [[ APEX SCRIPT FIXED - KAITUN BLOX FRUITS ]] --

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CommF_ = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Cấu hình cơ bản
getgenv().ApexConfig = {
    AutoFruit = true,
    AutoBuyStyle = true,
    FightingStyle = "Superhuman", -- Đổi tên võ bạn muốn mua vào đây
    Team = "Marines" -- Hoặc "Pirates"
}

-- 1. Tạo Giao diện Status ở giữa màn hình phía trên
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ApexStatusGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local statusLabel = Instance.new("TextLabel")
statusLabel.Name = "StatusText"
statusLabel.Size = UDim2.new(0, 480, 0, 55)
statusLabel.Position = UDim2.new(0.5, -240, 0.04, 0)
statusLabel.AnchorPoint = Vector2.new(0.5, 0)
statusLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
statusLabel.BackgroundTransparency = 0.3
statusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
statusLabel.TextSize = 15
statusLabel.Font = Enum.Font.GothamBold
statusLabel.Text = "Status: Khởi chạy thành công (Bỏ qua Auto Quest Web)..."
statusLabel.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = statusLabel

local function updateStatus(text)
    statusLabel.Text = "Status: " .. text
    print("[Apex Script]: " .. text)
end

-- 2. Chống AFK tránh bị văng khỏi Server
task.spawn(function()
    local vu = game:GetService("VirtualUser")
    LocalPlayer.Idled:Connect(function()
        vu:Button2Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
        task.wait(1)
        vu:Button2Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
    end)
end)

-- 3. Tự động chọn phe
task.spawn(function()
    pcall(function()
        if LocalPlayer.Team == nil then
            CommF_:InvokeServer("SetTeam", getgenv().ApexConfig.Team)
            task.wait(3)
        end
    end)
end)

-- 4. Vòng lặp chính xử lý các tính năng cốt lõi
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local level = LocalPlayer.Data.Level.Value
            
            -- A. Kiểm tra & Tự động đổi Sea khi đủ Level
            if level >= 700 and game.PlaceId == 2753915549 then
                updateStatus("Đạt Level 700 -> Tiến hành sang Sea 2...")
                CommF_:InvokeServer("GetUnlockMilitaryDetective")
                task.wait(1)
                CommF_:InvokeServer("UnlockMilitaryDetective")
                task.wait(1)
                CommF_:InvokeServer("TravelDressrosa")
                return
            elseif level >= 1500 and game.PlaceId == 4442272183 then
                updateStatus("Đạt Level 1500 -> Tiến hành sang Sea 3...")
                CommF_:InvokeServer("TravelZou")
                task.wait(1)
                return
            end

            -- B. Tự động nhặt và cất trái cây vào kho
            if getgenv().ApexConfig.AutoFruit then
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Tool") and v.Name:find("Fruit") then
                        updateStatus("Phát hiện trái: " .. v.Name .. " -> Đang nhặt!")
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                            task.wait(0.5)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, v.Handle, 0)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, v.Handle, 1)
                            task.wait(1)
                            
                            -- Lưu trữ vào kho
                            for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                                if item:IsA("Tool") and item.Name:find("Fruit") then
                                    updateStatus("Đang cất trái " .. item.Name .. " vào kho...")
                                    CommF_:InvokeServer("StoreFruit", item)
                                    task.wait(1)
                                end
                            end
                        end
                    end
                end
            end

            -- C. Tự động mua võ mới khi đủ điều kiện
            if getgenv().ApexConfig.AutoBuyStyle then
                CommF_:InvokeStatus = CommF_:InvokeServer("BuyItem", getgenv().ApexConfig.FightingStyle)
            end

            -- Trạng thái chờ hoạt động
            updateStatus("Level: " .. level .. " | Đang giám sát trái cây & chuyển Sea...")
        end)
    end
end)

print("Đã nạp thành công script tùy chỉnh từ Apex!")
