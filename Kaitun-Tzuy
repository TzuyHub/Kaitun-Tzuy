-- Hàm áp dụng chủ đề
local function ApDungChuDe(tenChuDe)
    local chuDe = Themes[tenChuDe]
    if not chuDe then return end
    CurrentTheme = tenChuDe
    
    -- Cập nhật tất cả các phần tử UI đã đăng ký
    for _, element in ipairs(UIElements) do
        if element.Type == "Frame" then
            element.Instance.BackgroundColor3 = chuDe.MainBG
        elseif element.Type == "SecondaryFrame" then
            element.Instance.BackgroundColor3 = chuDe.SecondaryBG
        elseif element.Type == "TextLabel" then
            element.Instance.TextColor3 = chuDe.Text
        elseif element.Type == "TextButton" then
            element.Instance.BackgroundColor3 = chuDe.Button
            element.Instance.TextColor3 = chuDe.Text
        elseif element.Type == "ScrollingFrame" then
            element.Instance.BackgroundColor3 = chuDe.SecondaryBG
        end
    end
end

-- Hàm đăng ký phần tử để áp dụng chủ đề
local function DangKyPhanTu(element, elementType)
    table.insert(UIElements, {Instance = element, Type = elementType})
end

