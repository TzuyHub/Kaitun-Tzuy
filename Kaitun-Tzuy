-- Thêm chức năng kéo thả cho khung chính
local dangKeo = false
local diemBatDau = nil
local viTriBatDau = nil

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dangKeo = true
        diemBatDau = input.Position
        viTriBatDau = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dangKeo = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if dangKeo and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - diemBatDau
        MainFrame.Position = UDim2.new(viTriBatDau.X.Scale, viTriBatDau.X.Offset + delta.X, viTriBatDau.Y.Scale, viTriBatDau.Y.Offset + delta.Y)
    end
end)

