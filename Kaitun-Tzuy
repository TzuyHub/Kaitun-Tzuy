-- ===== HÀM HỖ TRỢ =====
local function getPlayerLevel()
    local data = Player:FindFirstChild("Data")
    if data and data:FindFirstChild("Level") then
        return data.Level.Value
    end
    -- Fallback: đọc từ leaderstats nếu có
    local leaderstats = Player:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Level") then
        return leaderstats.Level.Value
    end
    return 0
end

local function getCurrentSea()
    local data = Player:FindFirstChild("Data")
    if data and data:FindFirstChild("Sea") then
        return data.Sea.Value
    end
    -- Fallback: dựa vào vị trí
    local pos = HumanoidRootPart.Position
    if pos.Magnitude < 2000 then
        return 1
    elseif pos.Magnitude < 8000 then
        return 2
    else
        return 3
    end
end

local function findModel(name)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == name and obj:FindFirstChild("Humanoid") then
            return obj
        end
    end
    return nil
end

local function findQuestNPC(npcName)
    return findModel(npcName)
end

local function findNearestEnemy(enemyName)
    local enemies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == enemyName and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local humanoid = obj.Humanoid
            if humanoid.Health > 0 then
                table.insert(enemies, obj)
            end
        end
    end
    if #enemies == 0 then return nil end
    table.sort(enemies, function(a, b)
        return (a.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude <
               (b.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude
    end)
    return enemies[1]
end

local function teleportTo(cframe)
    if HumanoidRootPart then
        HumanoidRootPart.CFrame = cframe
    end
end

local function equipMelee()
    local backpack = Player:FindFirstChild("Backpack")
    if not backpack then return end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Melee") then
            Humanoid:EquipTool(tool)
            return
        end
    end
    -- Nếu không có tool melee, thử equip tool đầu tiên
    local firstTool = backpack:FindFirstChildOfClass("Tool")
    if firstTool then
        Humanoid:EquipTool(firstTool)
    end
end

local function attack()
    if FarmMelee then
        equipMelee()
    end
    VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.1)
    VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function acceptQuest(npcName)
    if not AutoAcceptQuest then return end
    local npc = findQuestNPC(npcName)
    if not npc then return end
    
    -- Tìm ProximityPrompt trong NPC
    local prompt = npc:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(0.2)
            prompt:InputHoldEnd()
        end
        task.wait(1)
        
        -- Tìm nút Accept trong GUI
        local playerGui = Player:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in ipairs(playerGui:GetDescendants()) do
                if gui:IsA("TextButton") and (string.find(gui.Text, "Accept") or string.find(gui.Text, "Yes")) then
                    gui:Activate()
                    break
                end
            end
        end
    else
        -- Fallback: dùng click chuột ảo vào giữa màn hình (kém chính xác)
        local screenSize = GuiService:GetScreenResolution()
        VirtualInput:SendMouseButtonEvent(screenSize.X/2, screenSize.Y/2, 0, true, game, 0)
        task.wait(0.1)
        VirtualInput:SendMouseButtonEvent(screenSize.X/2, screenSize.Y/2, 0, false, game, 0)
    end
end

local function goToNextSea()
    local currentSea = getCurrentSea()
    local nextSea = currentSea + 1
    if nextSea <= 3 and SeaStartPositions[nextSea] then
        teleportTo(SeaStartPositions[nextSea])
        task.wait(2)
    end
end

-- ===== TÌM VÀ NHẶT TRÁI ÁC QUỶ =====
local function findFruit()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = obj.Name:lower()
            if string.find(name, "fruit") or string.find(name, "devil") then
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    return obj, prompt
                end
                -- Có thể trái là Tool không có prompt mà chỉ cần chạm vào
                if obj:FindFirstChild("Handle") then
                    return obj, nil
                end
            end
        end
    end
    return nil, nil
end

local function collectFruit()
    if not AutoCollectFruits then return end
    local fruit, prompt = findFruit()
    if not fruit then return end
    
    local fruitRoot = fruit:FindFirstChild("HumanoidRootPart") or fruit:FindFirstChild("Handle") or fruit.PrimaryPart
    if fruitRoot then
        -- Teleport tới gần trái
        if (fruitRoot.Position - HumanoidRootPart.Position).Magnitude > 50 then
            teleportTo(fruitRoot.CFrame * CFrame.new(0, 0, 5))
            task.wait(0.5)
        end
        
        if prompt then
            -- Dùng ProximityPrompt
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(0.2)
                prompt:InputHoldEnd()
            end
            fruitsCollected = fruitsCollected + 1
            updateStatus("🍈 Đã nhặt trái! Tổng: " .. fruitsCollected)
            task.wait(1)
        else
            -- Trường hợp trái là Tool, thử click vào giữa màn hình (nếu đang nhìn vào trái)
            local screenSize = GuiService:GetScreenResolution()
            VirtualInput:SendMouseButtonEvent(screenSize.X/2, screenSize.Y/2, 0, true, game, 0)
            task.wait(0.1)
            VirtualInput:SendMouseButtonEvent(screenSize.X/2, screenSize.Y/2, 0, false, game, 0)
            task.wait(1)
        end
    end
end

-- ===== VÒNG LẶP CHÍNH =====
task.spawn(function()
    -- Vòng lặp nhặt trái chạy song song
    while true do
        if AutoCollectFruits then
            collectFruit()
        end
        task.wait(2) -- Kiểm tra mỗi 2 giây
    end
end)

while true do
    local level = getPlayerLevel()
    local currentSea = getCurrentSea()
    
    -- Cập nhật status cơ bản
    local statusText = string.format(
        "⚔️ Đang farm\nLevel: %d | Sea: %d\nTrái đã nhặt: %d",
        level, currentSea, fruitsCollected
    )
    updateStatus(statusText)
    
    -- Kiểm tra auto advance sea
    if AutoAdvanceSea then
        if currentSea == 1 and level >= Sea2Level then
            updateStatus("🌊 Đủ level! Chuyển sang Sea 2...")
            goToNextSea()
            currentSea = getCurrentSea()
        elseif currentSea == 2 and level >= Sea3Level then
            updateStatus("🌊 Đủ level! Chuyển sang Sea 3...")
            goToNextSea()
            currentSea = getCurrentSea()
        end
    end
    
    -- Chọn vùng farm phù hợp
    local targetArea = nil
    local areaTable = Areas[currentSea]
    if areaTable then
        for _, area in ipairs(areaTable) do
            if level >= area.MinLevel and level <= area.MaxLevel then
                targetArea = area
                break
            end
        end
    end
    
    if not targetArea then
        -- Nếu không tìm thấy vùng phù hợp, dùng vùng cuối cùng của sea hiện tại
        if areaTable and #areaTable > 0 then
            targetArea = areaTable[#areaTable]
        else
            task.wait(1)
            continue
        end
    end
    
    -- Nhận quest
    updateStatus("📜 Nhận quest: " .. targetArea.Name .. "\n" .. statusText)
    acceptQuest(targetArea.NPC)
    
    -- Tìm quái gần nhất và farm
    local enemy = findNearestEnemy(targetArea.Enemy)
    if enemy then
        -- Teleport tới quái (nếu xa)
        if (enemy.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude > 100 then
            teleportTo(enemy.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5))
            task.wait(0.5)
        end
        
        -- Tấn công cho tới khi quái chết
        while enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 do
            updateStatus("⚔️ Farm " .. targetArea.Enemy .. " (Level: " .. level .. ")\n" .. statusText)
            attack()
            task.wait(AttackDelay)
            enemy = findNearestEnemy(targetArea.Enemy) -- cập nhật nếu quái mới gần hơn
        end
    else
        -- Không có quái, đứng chờ hoặc tìm chỗ khác
        updateStatus("⏳ Không tìm thấy quái, chờ...")
        task.wait(2)
    end
    
    task.wait(0.5) -- nghỉ giữa các chu kỳ
end
