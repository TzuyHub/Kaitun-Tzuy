-- 5. VÒNG LẶP CHÍNH XỬ LÝ HOẠT ĐỘNG
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local level = LocalPlayer.Data.Level.Value
            
            -- A. Kiểm tra & Chuyển Sea tự động
            if level >= 700 and game.PlaceId == 2753915549 then
                updateStatus("Đạt Level 700 -> Tiến hành làm nhiệm vụ sang Sea 2")
                CommF_:InvokeServer("GetUnlockMilitaryDetective")
                task.wait(1)
                CommF_:InvokeServer("UnlockMilitaryDetective")
                task.wait(1)
                CommF_:InvokeServer("TravelDressrosa")
                return
            elseif level >= 1500 and game.PlaceId == 4442272183 then
                updateStatus("Đạt Level 1500 -> Tiến hành làm nhiệm vụ sang Sea 3")
                CommF_:InvokeServer("TravelZou")
                task.wait(1)
                return
            end

            -- B. Tự động Nhặt & Cất Trái Cây (Ưu tiên cao nhất)
            if getgenv().Kaitun.AutoFruit then
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Tool") and v.Name:find("Fruit") then
                        updateStatus("Phát hiện trái cây: " .. v.Name .. " -> Đang bay đến nhặt!")
                        if v:FindFirstChild("Handle") then
                            tweenTo(v.Handle.CFrame)
