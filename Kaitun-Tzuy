-- [[ NIGHT HUB STYLE - ULTIMATE FAST KAITUN ]] --

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local CommF_ = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

getgenv().NightHubConfig = {
    FastAttack = true,
    TweenSpeed = 350,
    AutoStoreFruit = true, -- Tự động lưu trữ trái cây tối ưu
    AutoBuyStyle = true,
    FightingStyle = "Superhuman",
    Team = "Marines"
}

-- 1. Giao diện Status giữa màn hình chuẩn Kaitun Hub
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "NightHubStyleGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local statusLabel = Instance.new("TextLabel")
statusLabel.Name = "StatusText"
statusLabel.Size = UDim2.new(0, 500, 0, 50)
statusLabel.Position = UDim2.new(0.5, -250, 0.03, 0)
statusLabel.AnchorPoint = Vector2.new(0.5, 0)
statusLabel.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
statusLabel.BackgroundTransparency = 0.25
statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
statusLabel.TextSize = 15
statusLabel.Font = Enum.Font.GothamBold
statusLabel.Text = "Status: Đang kết nối lõi Night Hub Kaitun..."
statusLabel.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 6)
uiCorner.Parent = statusLabel

local function updateStatus(text)
    statusLabel.Text = "Status: " .. text
end

-- 2. Hàm Tween tốc độ cao mượt mà
local function fastTween(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local timeTravel = distance / getgenv().NightHubConfig.TweenSpeed
    
    local tweenInfo = TweenInfo.new(timeTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
end

