-- 2. Hệ thống Tween nhanh & chống Anti-Cheat Kick/Ban
local function safeTween(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local timeTravel = distance / getgenv().UltimateConfig.TweenSpeed
    
    -- Kiểm tra nếu khoảng cách quá lớn, dùng ngắt quãng nhỏ để server không phát hiện teleport bất thường
    if distance > 1000 then
        hrp.CFrame = targetCFrame
        task.wait(0.1)
        return
    end
    
    local tweenInfo = TweenInfo.new(timeTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

