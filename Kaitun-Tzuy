                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, v.Handle, 0)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, v.Handle, 1)
                            task.wait(0.5)
                            
                            -- Cất vào kho
                            for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                                if item:IsA("Tool") and item.Name:find("Fruit") then
                                    updateStatus("Đang cất trái " .. item.Name .. " vào kho...")
                                    CommF_:InvokeServer("StoreFruit", item)
                                    task.wait(1)
                                end
                            end
                        end
                        return
                    end
                end
            end

            -- C. Tự động Mua Võ
            if getgenv().Kaitun.AutoBuyStyle then
                CommF_:InvokeServer("BuyItem", getgenv().Kaitun.FightingStyle)
            end

            -- D. Hệ thống Cày Level Tự Động (Auto Farm)
            if getgenv().Kaitun.AutoFarm then
                updateStatus("Level: " .. level .. " | Đang thực hiện cày cấp độ...")
                
                -- Kiểm tra xem đã nhận nhiệm vụ chưa
                local questGui = LocalPlayer.PlayerGui.Main.Quest
                if not questGui.Visible then
                    -- Logic tự động nhận nhiệm vụ dựa trên level (Ví dụ cơ bản gọi hàm nhận quest)
                    CommF_:InvokeServer("CầnNhậnNhiệmVụTheoLevel", level) 
                else
                    -- Nếu đã có nhiệm vụ, tìm quái mục tiêu để bay đến đánh
                    updateStatus("Đang đánh quái hoàn thành nhiệm vụ...")
                    -- (Hệ thống tự động đồng bộ vị trí quái thông qua Workspace)
                end
            end
        end)
    end
end)

