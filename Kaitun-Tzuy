-- 4. Tự động chọn phe
task.spawn(function()
    pcall(function()
        if LocalPlayer.Team == nil then
            CommF_:InvokeServer("SetTeam", getgenv().NightHubConfig.Team)
        end
    end)
end)

-- 5. Fast Attack tối ưu hóa bỏ qua độ trễ
task.spawn(function()
    while task.wait(0.01) do
        if getgenv().NightHubConfig.FastAttack then
            pcall(function()
                local combatFramework = debug.getupvalues(require(LocalPlayer.PlayerScripts.CombatFramework))
                local c = combatFramework[2]
                if c and c.activeController then
                    c.activeController.timeToNextAttack = 0
                    c.activeController.hitboxMagnitude = 65
                    c.activeController:attack()
                end
            end)
        end
    end
end)

-- 6. Vòng lặp chính xử lý Nhặt / Lưu Trữ Trái Cây & Đổi Sea chuẩn xác
task.spawn(function()
    while task.wait(0.05) do
        pcall(function()
            local level = LocalPlayer.Data.Level.Value
            
            -- A. Kiểm tra & Đổi Sea tự động
            if level >= 700 and game.PlaceId == 2753915549 then
                updateStatus("Đạt Level 700 -> Kích hoạt chuyển sang Sea 2!")
                CommF_:InvokeServer("GetUnlockMilitaryDetective")
                CommF_:InvokeServer("UnlockMilitaryDetective")
                CommF_:InvokeServer("TravelDressrosa")
                return
            elseif level >= 1500 and game.PlaceId == 4442272183 then
                updateStatus("Đạt Level 1500 -> Kích hoạt chuyển sang Sea 3!")
                CommF_:InvokeServer("TravelZou")
                return
            end

            -- B. Hệ thống Tự động Nhặt & Lưu Trữ Trái Cây (Được fix lỗi lưu kho chuẩn Night Hub)
            if getgenv().NightHubConfig.AutoStoreFruit then
                -- Quét trong Workspace (Trái rơi ngoài đất)
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Tool") and v.Name:find("Fruit") then
                        updateStatus("PHÁT HIỆN TRÁI: " .. v.Name .. " -> Bay đến nhặt lập tức!")
                        if v:FindFirstChild("Handle") then
                            fastTween(v.Handle.CFrame)
                            task.wait(0.2)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, v.Handle, 0)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, v.Handle, 1)
                            task.wait(0.3)
                        end
                    end
                end

                -- Quét trong Backpack (Balo) để chắc chắn cất toàn bộ trái cây vào kho lưu trữ
                for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                    if item:IsA("Tool") and item.Name:find("Fruit") then
                        updateStatus("Đang lưu trữ trái " .. item.Name .. " vào kho...")
                        CommF_:InvokeServer("StoreFruit", item)
                        task.wait(0.5)
                    end
                end
                
                -- Quét thêm trên Character (phòng trường hợp đang cầm trên tay)
                if LocalPlayer.Character then
                    for _, item in pairs(LocalPlayer.Character:GetChildren()) do
                        if item:IsA("Tool") and item.Name:find("Fruit") then
                            updateStatus("Đang lưu trữ trái trên tay " .. item.Name .. " vào kho...")
                            CommF_:InvokeServer("StoreFruit", item)
                            task.wait(0.5)
                        end
                    end
                end
            end

            -- C. Tự động mua võ mới
            if getgenv().NightHubConfig.AutoBuyStyle then
                CommF_:InvokeServer("BuyItem", getgenv().NightHubConfig.FightingStyle)
            end

            updateStatus("Level: " .. level + " | Trạng thái: Đang canh trái cây, mua võ & đổi Sea...")
        end)
    end
end)

print("Night Hub Style Kaitun đã nạp thành công!")
