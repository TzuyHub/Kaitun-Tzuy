-- Pseudocode - KHÔNG CHẠY ĐƯỢC TRÊN ROBLOX
while true do
    local hasFist = false
    local chestsOpened = 0

    -- Thu thập tối đa 36 rương
    while chestsOpened < 36 and not hasFist do
        moveToNearestChest()          -- giả định có hàm di chuyển đến rương gần nhất
        openChest()
        if checkItem("Fist of Darkness") then
            hasFist = true
        end
        chestsOpened = chestsOpened + 1
        wait(1) -- chờ một chút
    end

    if hasFist then
        -- Triệu hồi Darkbeard
        moveToDarkArena()
        useItem("Fist of Darkness")
        wait(5) -- chờ boss xuất hiện

        -- Tự động đánh boss (giả định có hàm chiến đấu)
        while bossAlive("Darkbeard") do
            attackBoss()
            wait(0.5)
        end

        -- Kiểm tra rơi đồ
        if checkItem("Dark Coat") then
            print("Đã nhận được Áo Choàng Râu Đen!")
            break  -- thoát vòng lặp
        end
    else
        -- Không có Fist -> nhảy server và được treo 4 tiếng
        serverHop()          -- giả định có hàm nhảy server
        wait(4 * 60 * 60)   -- được treo 4 giờ (tính bằng giây)
    end
end
